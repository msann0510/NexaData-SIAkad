
Table "dosen" {
  "id_dosen" varchar(10) [pk, not null]
  "nama_dosen" varchar(100) [not null]
  "id_prodi" varchar(10) [not null]

  Indexes {
    id_prodi [name: "id_prodi"]
  }
}

Table "fakultas" {
  "id_fakultas" varchar(10) [pk, not null]
  "nama_fakultas" varchar(100) [not null]
  "no_gedung" int [not null]
}

Table "jadwal_kuliah" {
  "id_jadwal" varchar(10) [pk, not null]
  "id_kelas" varchar(10) [not null]
  "hari" varchar(10) [not null]
  "jam_mulai" time [not null]
  "jam_selesai" time [not null]
  "ruangan" varchar(10) [not null]

  Indexes {
    id_kelas [name: "id_kelas"]
  }
}

Table "kelas" {
  "id_kelas" varchar(10) [pk, not null]
  "nama_kelas" varchar(10) [not null]
  "kode_mk" varchar(10) [not null]
  "id_dosen" varchar(10) [not null]

  Indexes {
    kode_mk [name: "kode_mk"]
    id_dosen [name: "id_dosen"]
  }
}

Table "khs" {
  "id_khs" varchar(10) [pk, not null]
  "nim" varchar(20) [not null]
  "semester" int [not null]
  "ips" decimal(3,2) [not null]
  "total_sks" int [not null]

  Indexes {
    nim [name: "nim"]
  }
}

Table "krs" {
  "id_krs" varchar(10) [pk, not null]
  "nim" varchar(20) [not null]
  "id_kelas" varchar(10) [not null]
  "semester" int [not null]
  "tanggal_krs" date [not null]
  "status_krs" varchar(20) [not null]

  Indexes {
    nim [name: "nim"]
    id_kelas [name: "id_kelas"]
  }
}

Table "mahasiswa" {
  "nim" varchar(20) [pk, not null]
  "nama_mahasiswa" varchar(100) [not null]
  "jenis_kelamin" char(1) [not null]
  "tanggal_lahir" date [not null]
  "alamat" varchar(100) [not null]
  "id_prodi" varchar(10) [not null]

  Indexes {
    id_prodi [name: "id_prodi"]
  }
}

Table "matakuliah" {
  "kode_mk" varchar(10) [pk, not null]
  "nama_mk" varchar(20) [not null]
  "sks" int [not null]
  "semester" int [not null]
  "id_prodi" varchar(10) [not null]

  Indexes {
    id_prodi [name: "id_prodi"]
  }
}

Table "presensi" {
  "id_presensi" varchar(10) [pk, not null]
  "nim" varchar(20) [not null]
  "id_kelas" varchar(10) [not null]
  "tanggal" date [not null]
  "pertemuan_ke" int [not null]
  "status_hadir" varchar(15) [not null]

  Indexes {
    nim [name: "nim"]
    id_kelas [name: "id_kelas"]
  }
}

Table "prodi" {
  "id_prodi" varchar(10) [pk, not null]
  "nama_prodi" varchar(100) [not null]
  "id_fakultas" varchar(10) [not null]

  Indexes {
    id_fakultas [name: "id_fakultas"]
  }
}

Table "tanskrip" {
  "id_transkrip" varchar(10) [pk, not null]
  "nim" varchar(20) [not null]
  "ipk" decimal(3,2) [not null]
  "total_sks_lulus" int [not null]
  "tanggal_cetak" date [not null]

  Indexes {
    nim [name: "nim"]
  }
}


Ref: dosen.id_prodi > prodi.id_prodi

Ref: jadwal_kuliah.id_kelas > kelas.id_kelas

Ref: kelas.kode_mk > matakuliah.kode_mk

Ref: kelas.id_dosen > dosen.id_dosen

Ref: khs.nim > mahasiswa.nim

Ref: krs.nim > mahasiswa.nim

Ref: krs.id_kelas > kelas.id_kelas

Ref: mahasiswa.id_prodi > prodi.id_prodi

Ref: matakuliah.id_prodi > prodi.id_prodi

Ref: presensi.nim > mahasiswa.nim

Ref: presensi.id_kelas > kelas.id_kelas

Ref: prodi.id_fakultas > fakultas.id_fakultas

Ref: tanskrip.nim > mahasiswa.nim
```